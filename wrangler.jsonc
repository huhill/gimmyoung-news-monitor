{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gimmyoung-news-monitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
